# ─────────────────────────────────────────────────────────────
# MiniGamesLearning — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/mini_games_learning

# Separate test database (used by integration tests)
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/mini_games_learning_test

# OpenAI API key — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# JWT secrets — use long random strings (e.g. openssl rand -hex 64)
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# Express session secret
SESSION_SECRET=change-me-to-yet-another-random-string

# Server port (default: 3001)
PORT=3001

# Frontend origin for CORS (Vite default: 5173)
CLIENT_URL=http://localhost:5173

# Node environment: development | test | production
NODE_ENV=development
